# Metamorph Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# LLM Providers (Configure at least one)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Default LLM provider ("groq" or "gemini")
DEFAULT_LLM_PROVIDER=groq

# Sandbox Execution: "docker" or "subprocess" (auto-falls back to subprocess if Docker daemon is not running)
SANDBOX_MODE=auto

# Storage
RUNS_DB_PATH=runs.db
WORKSPACES_DIR=./workspaces
REPORTS_DIR=./reports
